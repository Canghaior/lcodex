{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "noEmit": true, "skipLibCheck": true, "types": ["react", "react-dom"]
